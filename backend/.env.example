# Server
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dms_autohaus
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
UPLOADS_DIR=./uploads
MAX_FILE_SIZE=52428800

# Email (IMAP for lead parsing)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=leads@autohaus.de
IMAP_PASSWORD=email_password
IMAP_TLS=true

# SMTP (outbound)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@autohaus.de
SMTP_PASSWORD=smtp_password

# Mobile.de API
MOBILEDE_USERNAME=your_mobile_username
MOBILEDE_PASSWORD=your_mobile_password

# AutoScout24 API
AS24_TOKEN=your_autoscout_token

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
